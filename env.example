# 选择使用 OpenAI 或 Gemini（至少设置一个）
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# 可选：显式指定使用的提供商（如果不设置，会自动检测）
# LLM_PROVIDER=gemini

# 可选：默认模型名称（当代码/API/CLI 没有显式传 model_name 时生效）
# 1) 按 provider 指定（优先级最高）
# GEMINI_MODEL_NAME=gemini-2.0-flash
# OPENAI_MODEL_NAME=gpt-4
#
# 2) 全局默认（当未设置 GEMINI_MODEL_NAME/OPENAI_MODEL_NAME 时使用）
# LLM_MODEL_NAME=gemini-2.0-flash
